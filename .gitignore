# ============================================================
# 明文内容目录 —— 绝对不能进仓库
#
# 仓库为 public，一旦提交明文，内容会公开且永久留在 git 历史中
# （即使日后删除也无法擦除）。
#
# 仓库里存的是 content-encrypted/（密文），由
# scripts/encrypt-content.mjs 从本目录生成。
# ============================================================
/content/

# Hugo 构建产物
/public/
/resources/_gen/
.hugo_build.lock

# Hugo 本地缓存
/.hugo/

# 密码绝不入库：本地用 .env 存，配合 scripts/publish.sh 读取
.env

# macOS
.DS_Store
._*

# 编辑器
.idea/
.vscode/
*.swp

# 常见误提交：手机导出的原图临时目录
/tmp/
